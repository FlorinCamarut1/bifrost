{
  "name": "bifrost",
  "productName": "Bifrost",
  "version": "2.2.4",
  "description": "Valheim and Enshrouded mod manager and server companion",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "basic-ftp": "^5.3.1",
    "dompurify": "^3.4.16",
    "js-yaml": "4.1.0",
    "marked": "^17.0.6",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  },
  "author": "Florin Camarut",
  "license": "MIT",
  "repository": "https://github.com/FlorinCamarut1/bifrost",
  "build": {
    "appId": "io.github.florincamarut1.bifrost",
    "productName": "Bifrost",
    "files": [
      "main.js",
      "preload.js",
      "catalog-worker.js",
      "lib/**",
      "ui/**",
      "package.json",
      "!build/**",
      "!docs/**"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/win/**",
      "node_modules/7zip-bin/linux/x64/**",
      "node_modules/node-unrar-js/dist/js/unrar.wasm",
      "catalog-worker.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/app.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "ui/app.ico",
          "to": "app.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Bifrost",
      "artifactName": "Bifrost-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FlorinCamarut1",
        "repo": "bifrost",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Bifrost invite",
        "schemes": [
          "bifrost"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/app.png",
      "category": "Game",
      "executableName": "bifrost",
      "maintainer": "FlorinCamarut1 <95957482+FlorinCamarut1@users.noreply.github.com>",
      "synopsis": "Valheim mod manager and server companion",
      "desktop": {
        "entry": {
          "StartupWMClass": "Bifrost",
          "MimeType": "x-scheme-handler/bifrost;x-scheme-handler/nxm;"
        }
      }
    },
    "appImage": {
      "artifactName": "Bifrost-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "Bifrost-${version}-linux-amd64.${ext}",
      "depends": [
        "libnss3",
        "libgbm1",
        "libasound2 | libasound2t64",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libsecret-1-0",
        "file"
      ]
    }
  },
  "homepage": "https://github.com/FlorinCamarut1/bifrost"
}
